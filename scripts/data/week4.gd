					{"t": "end", "if": "dragged", "text": "엔딩: 안 읽는 게 편해"},
					{"t": "end", "if": "home_cuffed", "text": "엔딩: 수갑"},
					{"t": "end", "if": "rel:bulbasaur", "text": "엔딩: 첫 포켓몬"},
					{"t": "end", "if": "d_turn", "text": "엔딩: 돌아온 차례"},
					{"t": "end", "text": "엔딩: 빈 몬스터볼"},
				]},
